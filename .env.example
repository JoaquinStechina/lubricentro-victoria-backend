DATABASE_URL="mysql://usuario:contraseña@localhost:3306/lubricentro_victoria"
PORT=4000
# Origen exacto del frontend (para CORS con credentials: true — no puede
# ser "*" cuando se mandan cookies cross-origin).
FRONTEND_URL=http://localhost:3000
# Secreto para firmar/verificar el JWT de sesión. Debe ser el mismo valor
# que JWT_SECRET en lubricentro-victoria-front/.env.local. Generar con:
# openssl rand -base64 32
JWT_SECRET=
# Credenciales del primer usuario SYSADMIN, usadas solo por
# `npm run seed:sysadmin` (no se leen en runtime del server).
SYSADMIN_EMAIL=
SYSADMIN_PASSWORD=
SYSADMIN_NOMBRE=
# Necesaria para extraer pdf/png y para sugerir el mapeo de columnas de
# proveedores nuevos. Sin esto, el resto del backend funciona igual.
OPENROUTER_API_KEY=
# Opcionales: por defecto ambos usan "anthropic/claude-sonnet-5" via
# OpenRouter. Los PDF se renderizan página por página como imagen antes de
# mandarlos al modelo (ver vision.ts), así que OPENROUTER_VISION_MODEL solo
# necesita soporte de visión/imágenes, no soporte nativo de PDF. Ver
# openrouter.ai/models para otros modelos si se quiere probar otro proveedor.
OPENROUTER_VISION_MODEL=
OPENROUTER_MAPPING_MODEL=
# Opcionales, solo afectan el ranking público de apps en OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
