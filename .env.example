DATABASE_URL="mysql://usuario:contraseña@localhost:3306/lubricentro_victoria"
# Base que usan los tests de integración (`npm run test:db`). Tiene que ser
# DISTINTA de DATABASE_URL: los tests la truncan entera antes de cada caso.
# Por seguridad, tanto los tests como `npm run test:db:preparar` se niegan a
# tocarla si el nombre de la base no contiene "test".
# Sin esta variable, los tests de integración se saltean con un aviso; los
# unitarios (`npm run test:unit`) corren igual.
TEST_DATABASE_URL="mysql://usuario:contraseña@localhost:3306/lubricentro_victoria_test"
PORT=4000
# Origen exacto del frontend, para el header CORS.
FRONTEND_URL=http://localhost:3000
# Necesaria para extraer pdf/png y para sugerir el mapeo de columnas de
# proveedores nuevos. Sin esto, el resto del backend funciona igual.
OPENROUTER_API_KEY=
# Opcionales: por defecto ambos usan "anthropic/claude-sonnet-5" via
# OpenRouter. Los PDF se renderizan página por página como imagen antes de
# mandarlos al modelo (ver vision.ts), así que OPENROUTER_VISION_MODEL solo
# necesita soporte de visión/imágenes, no soporte nativo de PDF. Ver
# openrouter.ai/models para otros modelos si se quiere probar otro proveedor.
OPENROUTER_VISION_MODEL=
OPENROUTER_MAPPING_MODEL=
# Opcionales, solo afectan el ranking público de apps en OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
# Credenciales del portal de ABC (abc-sa.com.ar) para la auto-descarga diaria
# de listas de precios por marca (ver backend/src/automation/abcAutoDescarga.ts
# y /cargas/auto-descargas en el frontend). Sin esto, el cron y "Probar ahora"
# fallan con "Faltan ABC_PORTAL_USUARIO / ABC_PORTAL_CLAVE en el entorno".
ABC_PORTAL_USUARIO=
ABC_PORTAL_CLAVE=
# Opcional: campo "Usuario Colaborador" del login de ABC, si la cuenta lo usa.
ABC_PORTAL_COLABORADOR=
# Link de Dropbox compartido de BORUR (proveedor con mecanismoAutoDescarga =
# "dropbox_directo"), usado solo por scripts/seed-borur-auto-descargas.ts al
# configurar el proveedor y sus 25 marcas. Sin esto, ese script falla
# explícitamente. Ver backend/src/automation/dropboxAutoDescarga.ts.
BORUR_DROPBOX_URL=
