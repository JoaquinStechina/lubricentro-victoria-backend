generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  productos      ProductoPrecio[]
  ofertas        Oferta[]
  mapeos         MapeoColumna[]
  cargas         Carga[]
  autoDescargas  AutoDescargaMarca[]

  // "abc_portal" | "dropbox_directo" | null (null = sin auto-descarga
  // configurada, proveedor solo de carga manual). Determina qué worker de
  // automation/ procesa las filas de AutoDescargaMarca de este proveedor
  // (ver docs/superpowers/specs/2026-07-28-borur-auto-descarga-design.md).
  mecanismoAutoDescarga String?
  // Solo aplica a mecanismoAutoDescarga = "dropbox_directo": el link
  // compartido (uno solo, no por marca — todas las marcas de un proveedor
  // "dropbox_directo" viven en el mismo archivo).
  // @db.Text: un link de Dropbox real (scl/fo con rlkey + nombre de archivo
  // URL-encodeado) puede superar los 191 caracteres del VARCHAR default —
  // confirmado con el link real de BORUR (195 caracteres). Este campo nunca
  // se busca por igualdad ni se indexa, así que no hay costo real en no
  // acotarlo.
  urlDescargaAutomatica String? @db.Text
  // Solo aplica cuando una fila no tiene columna de IVA mapeada: valor de
  // alicuota_iva a usar como fallback (ver applyMapping en mapping.ts). null
  // = no inventar nada, comportamiento de siempre.
  alicuotaIvaDefault    Float?

  @@map("proveedores")
}

// Marcas de un proveedor que se auto-descargan por Playwright (ver
// backend/src/automation/abcAutoDescarga.ts). Genérico por proveedorId por si
// en el futuro hay otro proveedor con portal propio, aunque hoy solo se usa
// con ABC (ver docs/superpowers/specs/2026-07-23-abc-auto-descarga-marcas-design.md).
model AutoDescargaMarca {
  id                 Int       @id @default(autoincrement())
  proveedorId        Int
  proveedor          Proveedor @relation(fields: [proveedorId], references: [id])
  marca              String
  activo             Boolean   @default(true)
  porcentajeGanancia Float?
  ultimoHashArchivo  String?
  ultimaCorridaEn    DateTime?
  ultimoResultado    String?
  ultimaCargaId      Int?
  createdAt          DateTime  @default(now())

  @@unique([proveedorId, marca])
  @@map("auto_descargas_marca")
}

// Schema canónico productos_precios (ver contexto.md). No se hace UPDATE
// destructivo de precios: cada carga nueva inserta filas con su propia
// fechaVigencia para poder auditar variaciones en el tiempo.
model ProductoPrecio {
  id                Int       @id @default(autoincrement())
  proveedorId       Int
  proveedor         Proveedor @relation(fields: [proveedorId], references: [id])
  marca             String?
  skuProveedor      String?
  skuInterno        String?
  descripcion       String?   @db.Text
  seccion           String?
  precioNeto        Float?
  precioConIva      Float?
  precioLista       Float?
  precioListaConIva Float?
  precioSugerido    Float?
  alicuotaIva       Float?
  moneda            String    @default("ARS")
  unidad            String?
  fechaVigencia     String?
  imagenUrl         String?
  // true = la fila mas reciente conocida para este proveedor+marca+SKU.
  // Al confirmar una carga nueva, la fila anterior de ese mismo
  // proveedor+marca+SKU se marca en false (ver publicarCanonicalRows en
  // processCarga.ts) - nunca se borra ni se pisa, solo se deja de considerar
  // vigente. Filas sin skuProveedor no tienen forma confiable de matchear
  // "el mismo producto" y quedan siempre en true (no se tocan).
  vigente           Boolean   @default(true)
  // Borrado lógico: true = oculta de GET /api/productos y de la UI. Nunca
  // se borra la fila físicamente. Independiente de `vigente` (que tiene
  // otro significado, ver arriba).
  eliminado         Boolean   @default(false)
  rawData           Json?
  cargaId           Int?
  carga             Carga?    @relation(fields: [cargaId], references: [id])
  createdAt         DateTime  @default(now())

  @@index([proveedorId])
  @@index([skuInterno])
  @@index([skuProveedor])
  @@index([proveedorId, marca, skuProveedor])
  @@map("productos_precios")
}

model Oferta {
  id             Int      @id @default(autoincrement())
  proveedorId    Int
  proveedor      Proveedor @relation(fields: [proveedorId], references: [id])
  marca          String
  numeroOferta   Int
  skuProveedor   String
  descripcion    String   @db.Text
  desdeCantidad  Int
  descuentoPct   Float
  precioUnitario Float
  moneda         String   @default("ARS")
  fechaOferta    String
  horaOferta     String
  // Fecha de vencimiento declarada por el proveedor (archivo/banner, mismo
  // origen que fechaOferta/horaOferta - ver ofertaMetadata.ts), en formato
  // YYYY-MM-DD para poder compararla como texto sin parsear fechas. null =
  // sin fecha fija ("hasta agotar stock"): se cierra solo con la accion
  // manual de POST /api/ofertas/cerrar, nunca con un job automatico.
  fechaHasta     String?
  // Stock disponible para esta oferta, si el proveedor lo informa (columna
  // tipo "Cantidad disponible"/"Stock disponible" en el archivo de origen).
  // Opcional: la mayoría de los proveedores no la traen, y nunca se infiere
  // ni se completa con un default - queda null si no viene en el archivo.
  cantidadDisponible Int?
  imagenUrl      String?
  // Nunca la toca el pipeline de extraccion/mapeo: arranca en true al
  // publicar y solo cambia via POST /api/ofertas/cerrar o /reactivar.
  activa         Boolean  @default(true)
  // Borrado lógico, independiente de `activa` (que significa "oferta
  // cerrada/vencida", ver arriba). Nunca se borra la fila físicamente.
  eliminado      Boolean  @default(false)
  archivoOrigen  String
  rawData        Json?
  cargaId        Int?
  carga          Carga?   @relation(fields: [cargaId], references: [id])
  createdAt      DateTime @default(now())

  @@index([proveedorId])
  @@map("ofertas")
}

// Mapeo columna origen -> campo del schema canónico, por proveedor.
// Se guarda una vez que un humano aprueba el mapeo sugerido (ver
// contexto.md, etapas 3-4 del pipeline) y se reusa en cargas siguientes
// del mismo proveedor sin volver a pedir aprobación.
model MapeoColumna {
  id            Int      @id @default(autoincrement())
  proveedorId   Int
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])
  columnaOrigen String
  campoDestino  String
  // "catalogo" | "oferta" — un proveedor puede tener una columna "SKU" en su
  // catálogo y otra columna "SKU" en sus ofertas que mapee distinto; sin este
  // discriminador colisionarían en la misma fila de mapeo aprobado.
  tipoDatos     String   @default("catalogo")
  createdAt     DateTime @default(now())

  // Antes era @@unique([proveedorId, columnaOrigen, tipoDatos]) — una sola
  // columna origen solo podía tener un campo destino guardado. Se relaja
  // para permitir mapeo uno-a-muchos (ej. una columna "Precio" que alimenta
  // precio_lista Y precio_neto a la vez): ahora puede haber varias filas
  // para la misma columnaOrigen, una por cada campoDestino asignado (ver
  // upsertMapeoColumnas en processCarga.ts).
  @@unique([proveedorId, columnaOrigen, campoDestino, tipoDatos])
  @@map("mapeos_columna")
}

// Una fila por archivo subido por el cliente. Es la etapa de "recepción"
// del pipeline (etapa 1): el archivo llega y queda en estado `pendiente`
// hasta que se dispara el procesamiento (extracción + mapeo de columnas)
// y publica productos/ofertas asociados a esta carga.
model Carga {
  id             Int       @id @default(autoincrement())
  proveedorId    Int?
  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id])
  nombreArchivo  String
  rutaArchivo    String
  tipoArchivo    String // xlsx | xls | pdf | png | jpg | jpeg — formato del archivo
  // "catalogo" | "oferta" — a diferencia de tipoArchivo (formato), esto dice
  // si el archivo se publica en ProductoPrecio o en Oferta.
  tipoDatos      String    @default("catalogo")
  // Solo aplica a tipoDatos = "oferta": el usuario indicó al subir el
  // archivo que la oferta no tiene fecha de cierre ("hasta agotar stock"),
  // así que la IA no intenta inferir metadataOferta.fecha_hasta y esta
  // queda null (ver detectOfertaMetadata/extractOfertaWithVision). Se
  // guarda aparte de fecha_hasta=null para poder distinguir "el usuario lo
  // marcó a propósito" de "la IA no encontró ninguna fecha".
  sinFechaLimite Boolean   @default(false)
  // Copiado de AutoDescargaMarca.porcentajeGanancia al crear la Carga desde
  // el worker de auto-descarga; null para cargas manuales o de otros
  // proveedores. ReviewTable.tsx lo usa para prellenar el % de ganancia en
  // vez de arrancar vacío (ver docs/superpowers/specs/2026-07-23-abc-auto-descarga-marcas-design.md).
  porcentajeGananciaDefault Float?
  // "manual" | "auto_descarga" — discriminador explícito de origen, no se
  // infiere de porcentajeGananciaDefault (puede ser null aunque la carga sí
  // venga de auto-descarga, si la fila no tiene % configurado). Solo las
  // cargas "auto_descarga" son candidatas a auto-publicación condicionada
  // (ver backend/src/automation/autoPublicacion.ts). Default "manual" para
  // no romper cargas existentes/subidas a mano.
  origen         String    @default("manual")
  // pendiente | procesando | revision_pendiente | confirmacion_pendiente |
  // completado | error. revision_pendiente = mapeo sugerido por IA sin
  // aprobar (proveedor nuevo o headers distintos); confirmacion_pendiente =
  // mapeo ya aprobado de antes, solo falta que un humano confirme los
  // valores. Ninguna carga se publica sola: procesarCarga() nunca llega a
  // "completado" por sí misma, hace falta POST /:id/confirmar.
  estado         String    @default("pendiente")
  mensajeError   String?   @db.Text
  // Filas crudas ya extraídas (headers originales -> valor), antes de
  // aplicar el mapeo de columnas. Se guardan para poder aplicar el mapeo
  // sin tener que re-extraer el archivo tras la revisión humana.
  filasExtraidas Json?
  // Mapeo columna origen -> campo canónico sugerido por el LLM cuando el
  // proveedor es nuevo o le cambiaron los headers (etapa 3-4 del pipeline).
  // Queda pendiente de aprobación humana antes de escribirse en
  // MapeoColumna y aplicarse.
  mapeoSugerido  Json?
  // Marca/n° de oferta/fecha/hora inferidos por IA del banner o del nombre
  // de archivo cuando tipoDatos = "oferta" (ver docs/plan-ofertas.md). Campo
  // separado de mapeoSugerido porque es un dato de archivo, no de columnas.
  metadataOferta Json?
  productos      ProductoPrecio[]
  ofertas        Oferta[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("cargas")
}

// Inventario propio del lubricentro. Deliberadamente separado de
// ProductoPrecio (que es el catálogo de listas de PROVEEDOR, versionado por
// `vigente` y con una fila por proveedor): en el estante hay una sola caja
// con una sola cantidad. El vínculo con el catálogo se resuelve por
// codigoNorm en la consulta, sin foreign key — ver GET /api/stock/reposicion.
model ArticuloStock {
  id          Int      @id @default(autoincrement())
  marca       String
  codigo      String
  // UPPER + sin espacios, guiones, puntos ni barras. Lo calcula el backend
  // (normalizarCodigo en src/lib/stock.ts) en cada alta y en cada edición que
  // toque `codigo`; el cliente nunca lo manda. Guardado, no computado en la
  // query, para poder indexarlo.
  codigoNorm  String
  descripcion String   @db.Text
  categoria   String?
  ubicacion   String?
  // Derivado de los movimientos pero persistido: la lista de artículos es la
  // vista principal y paginada, y un SUM por fila se degrada a medida que
  // crecen los movimientos. Se actualiza en la misma transacción que inserta
  // el movimiento, así no puede quedar desfasado.
  cantidad    Int      @default(0)
  // Umbral de reposición. null = el artículo no participa de las alertas.
  minimo      Int?
  // Borrado lógico, mismo criterio que ProductoPrecio y Oferta.
  eliminado   Boolean  @default(false)
  movimientos MovimientoStock[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([marca, codigo])
  @@index([codigoNorm])
  @@index([categoria])
  @@map("articulos_stock")
}

model MovimientoStock {
  id                 Int           @id @default(autoincrement())
  articuloId         Int
  articulo           ArticuloStock @relation(fields: [articuloId], references: [id])
  // "entrada" | "salida" | "ajuste"
  tipo               String
  // Con signo: entrada positivo, salida negativo, ajuste la diferencia contra
  // lo que había. Unifica la aritmética de los tres tipos.
  delta              Int
  // Foto del stock inmediatamente después de este movimiento. Sin esto,
  // auditar "¿cuándo se descuadró?" obliga a re-sumar desde el origen.
  cantidadResultante Int
  motivo             String?       @db.Text
  createdAt          DateTime      @default(now())

  @@index([articuloId])
  @@index([createdAt])
  @@map("movimientos_stock")
}
