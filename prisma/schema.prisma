generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SYSADMIN
  ADMINISTRADOR
  EMPLEADO
}

// Cuentas internas del sistema. El primer SYSADMIN se crea con
// scripts/seed-sysadmin.ts (no hay forma de crear el primero desde la UI,
// ya que solo un SYSADMIN puede crear cuentas). creadoPorId registra quién
// dio de alta cada cuenta (para auditoría, ver POST /api/usuarios).
model Usuario {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean   @default(true)
  creadoPorId  Int?
  creadoPor    Usuario?  @relation("UsuarioCreador", fields: [creadoPorId], references: [id])
  creados      Usuario[] @relation("UsuarioCreador")
  createdAt    DateTime  @default(now())

  @@map("usuarios")
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())

  productos ProductoPrecio[]
  ofertas   Oferta[]
  mapeos    MapeoColumna[]
  cargas    Carga[]

  @@map("proveedores")
}

// Schema canónico productos_precios (ver contexto.md). No se hace UPDATE
// destructivo de precios: cada carga nueva inserta filas con su propia
// fechaVigencia para poder auditar variaciones en el tiempo.
model ProductoPrecio {
  id            Int      @id @default(autoincrement())
  proveedorId   Int
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])
  marca         String?
  skuProveedor  String?
  skuInterno    String?
  descripcion   String?  @db.Text
  seccion       String?
  precioNeto    Float?
  precioConIva  Float?
  alicuotaIva   Float?
  moneda        String   @default("ARS")
  unidad        String?
  fechaVigencia String?
  // true = la fila mas reciente conocida para este proveedor+marca+SKU.
  // Al confirmar una carga nueva, la fila anterior de ese mismo
  // proveedor+marca+SKU se marca en false (ver publicarCanonicalRows en
  // processCarga.ts) - nunca se borra ni se pisa, solo se deja de considerar
  // vigente. Filas sin skuProveedor no tienen forma confiable de matchear
  // "el mismo producto" y quedan siempre en true (no se tocan).
  vigente       Boolean  @default(true)
  // Borrado lógico: true = oculta de GET /api/productos y de la UI. Nunca
  // se borra la fila físicamente. Independiente de `vigente` (que tiene
  // otro significado, ver arriba).
  eliminado     Boolean  @default(false)
  rawData       Json?
  cargaId       Int?
  carga         Carga?   @relation(fields: [cargaId], references: [id])
  createdAt     DateTime @default(now())

  @@index([proveedorId])
  @@index([skuInterno])
  @@index([skuProveedor])
  @@index([proveedorId, marca, skuProveedor])
  @@map("productos_precios")
}

model Oferta {
  id             Int      @id @default(autoincrement())
  proveedorId    Int
  proveedor      Proveedor @relation(fields: [proveedorId], references: [id])
  marca          String
  numeroOferta   Int
  skuProveedor   String
  descripcion    String   @db.Text
  desdeCantidad  Int
  descuentoPct   Float
  precioUnitario Float
  moneda         String   @default("ARS")
  fechaOferta    String
  horaOferta     String
  // Fecha de vencimiento declarada por el proveedor (archivo/banner, mismo
  // origen que fechaOferta/horaOferta - ver ofertaMetadata.ts), en formato
  // YYYY-MM-DD para poder compararla como texto sin parsear fechas. null =
  // sin fecha fija ("hasta agotar stock"): se cierra solo con la accion
  // manual de POST /api/ofertas/cerrar, nunca con un job automatico.
  fechaHasta     String?
  // Nunca la toca el pipeline de extraccion/mapeo: arranca en true al
  // publicar y solo cambia via POST /api/ofertas/cerrar o /reactivar.
  activa         Boolean  @default(true)
  // Borrado lógico, independiente de `activa` (que significa "oferta
  // cerrada/vencida", ver arriba). Nunca se borra la fila físicamente.
  eliminado      Boolean  @default(false)
  archivoOrigen  String
  rawData        Json?
  cargaId        Int?
  carga          Carga?   @relation(fields: [cargaId], references: [id])
  createdAt      DateTime @default(now())

  @@index([proveedorId])
  @@map("ofertas")
}

// Mapeo columna origen -> campo del schema canónico, por proveedor.
// Se guarda una vez que un humano aprueba el mapeo sugerido (ver
// contexto.md, etapas 3-4 del pipeline) y se reusa en cargas siguientes
// del mismo proveedor sin volver a pedir aprobación.
model MapeoColumna {
  id            Int      @id @default(autoincrement())
  proveedorId   Int
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])
  columnaOrigen String
  campoDestino  String
  // "catalogo" | "oferta" — un proveedor puede tener una columna "SKU" en su
  // catálogo y otra columna "SKU" en sus ofertas que mapee distinto; sin este
  // discriminador colisionarían en la misma fila de mapeo aprobado.
  tipoDatos     String   @default("catalogo")
  createdAt     DateTime @default(now())

  @@unique([proveedorId, columnaOrigen, tipoDatos])
  @@map("mapeos_columna")
}

// Una fila por archivo subido por el cliente. Es la etapa de "recepción"
// del pipeline (etapa 1): el archivo llega y queda en estado `pendiente`
// hasta que se dispara el procesamiento (extracción + mapeo de columnas)
// y publica productos/ofertas asociados a esta carga.
model Carga {
  id             Int       @id @default(autoincrement())
  proveedorId    Int?
  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id])
  nombreArchivo  String
  rutaArchivo    String
  tipoArchivo    String // xlsx | xls | pdf | png | jpg | jpeg — formato del archivo
  // "catalogo" | "oferta" — a diferencia de tipoArchivo (formato), esto dice
  // si el archivo se publica en ProductoPrecio o en Oferta.
  tipoDatos      String    @default("catalogo")
  // Solo aplica a tipoDatos = "oferta": el usuario indicó al subir el
  // archivo que la oferta no tiene fecha de cierre ("hasta agotar stock"),
  // así que la IA no intenta inferir metadataOferta.fecha_hasta y esta
  // queda null (ver detectOfertaMetadata/extractOfertaWithVision). Se
  // guarda aparte de fecha_hasta=null para poder distinguir "el usuario lo
  // marcó a propósito" de "la IA no encontró ninguna fecha".
  sinFechaLimite Boolean   @default(false)
  // pendiente | procesando | revision_pendiente | confirmacion_pendiente |
  // completado | error. revision_pendiente = mapeo sugerido por IA sin
  // aprobar (proveedor nuevo o headers distintos); confirmacion_pendiente =
  // mapeo ya aprobado de antes, solo falta que un humano confirme los
  // valores. Ninguna carga se publica sola: procesarCarga() nunca llega a
  // "completado" por sí misma, hace falta POST /:id/confirmar.
  estado         String    @default("pendiente")
  mensajeError   String?   @db.Text
  // Filas crudas ya extraídas (headers originales -> valor), antes de
  // aplicar el mapeo de columnas. Se guardan para poder aplicar el mapeo
  // sin tener que re-extraer el archivo tras la revisión humana.
  filasExtraidas Json?
  // Mapeo columna origen -> campo canónico sugerido por el LLM cuando el
  // proveedor es nuevo o le cambiaron los headers (etapa 3-4 del pipeline).
  // Queda pendiente de aprobación humana antes de escribirse en
  // MapeoColumna y aplicarse.
  mapeoSugerido  Json?
  // Marca/n° de oferta/fecha/hora inferidos por IA del banner o del nombre
  // de archivo cuando tipoDatos = "oferta" (ver docs/plan-ofertas.md). Campo
  // separado de mapeoSugerido porque es un dato de archivo, no de columnas.
  metadataOferta Json?
  productos      ProductoPrecio[]
  ofertas        Oferta[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("cargas")
}
